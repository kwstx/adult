// Prisma schema for High-Performance Real-Time Creator & Economic Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// 1. IDENTITY & USER ACCOUNTS
// --------------------------------------------------------------------------

model User {
  id               String                 @id @default(cuid())
  email            String                 @unique
  username         String                 @unique
  displayName      String
  avatarUrl        String?
  role             String                 @default("FAN") // FAN, CREATOR, MODERATOR, ADMIN
  kycStatus        String                 @default("UNVERIFIED") // UNVERIFIED, AGE_VERIFIED, COMPLIANCE_2257_APPROVED
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  wallet           Wallet?
  creatorProfile   CreatorProfile?
  subscriptions    Subscription[]         @relation("FanSubscriptions")
  ppvPurchases     PPVPurchase[]          @relation("FanPurchases")
  ageRecords       AgeAssuranceRecord[]
  reportsSubmitted ModerationReport[]     @relation("ReportedBy")
  reportsReceived  ModerationReport[]     @relation("ReportedUser")
  chatMessages     ChatMessage[]
  auditLogs        AuditLog[]
  discoveryEvents  DiscoveryEvent[]
  private1on1AsFan     Private1on1Session[] @relation("Fan1on1Sessions")
  private1on1AsCreator Private1on1Session[] @relation("Creator1on1Sessions")
}

// --------------------------------------------------------------------------
// 2. CREATOR OPERATING SYSTEM
// --------------------------------------------------------------------------

model CreatorProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                   String?
  bannerUrl             String?
  streamTitle           String                 @default("Welcome to my room! ✨")
  streamKey             String                 @unique @default(cuid())
  ingestUrl             String                 @default("rtmp://live.streamplatform.local/app")
  isLive                Boolean                @default(false)
  viewerCount           Int                    @default(0)
  currentGoalTitle      String                 @default("Dance celebration at 500 tokens! 💃")
  currentGoalTarget     Int                    @default(500)
  currentGoalProgress   Int                    @default(0)
  isPrivateShow         Boolean                @default(false)
  minTipForPrivate      Int                    @default(1000)
  tags                  String                 @default("dance,chill,interactive")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  interactionItems      InteractionMenuItem[]
  ppvContents           PPVContent[]
  liveSessions          LiveSession[]
  mediaRooms            MediaRoom[]
  videoLivestreams      VideoLivestream[]
  audienceRules         AudienceRule[]
  subscriberFans        Subscription[]         @relation("CreatorSubscriptions")
  compliance2257        Compliance2257Record?
  chatMessages          ChatMessage[]
  discoveryEvents       DiscoveryEvent[]
}

model InteractionMenuItem {
  id               String         @id @default(cuid())
  creatorId        String
  creator          CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  creditCost       Int            // Cost in credits (e.g. 50, 100, 250)
  actionType       String         // ALERT_SOUND, DANCE, WHEEL_SPIN, CHAT_HIGHLIGHT, PRIVATE_SNAP, CUSTOM
  isEnabled        Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
}

// --------------------------------------------------------------------------
// 3. ECONOMIC ENGINE (DOUBLE-ENTRY WALLET & LEDGER)
// --------------------------------------------------------------------------

model Wallet {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance          Int            @default(0) // Integer credit units (1 credit = $0.05 - $0.10)
  lockedBalance    Int            @default(0) // Credits on hold for payout processing
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  outgoingEntries  LedgerEntry[]  @relation("SourceWallet")
  incomingEntries  LedgerEntry[]  @relation("DestinationWallet")
}

model LedgerEntry {
  id                   String     @id @default(cuid())
  transactionType      String     // CREDIT_PURCHASE, LIVE_TIP, PPV_UNLOCK, SUBSCRIPTION, CREATOR_PAYOUT, PLATFORM_RAKE
  amount               Int        // Total credit magnitude
  sourceWalletId       String?
  sourceWallet         Wallet?    @relation("SourceWallet", fields: [sourceWalletId], references: [id])
  destinationWalletId  String?
  destinationWallet    Wallet?    @relation("DestinationWallet", fields: [destinationWalletId], references: [id])
  platformRakeCredits  Int        @default(0) // Platform commission (e.g. 20%)
  netCreatorCredits    Int        @default(0) // Net amount credited to creator (e.g. 80%)
  status               String     @default("COMPLETED") // PENDING, COMPLETED, FAILED, REVERSED
  idempotencyKey       String     @unique
  referenceId          String?    // Associated tipId, streamId, ppvId
  note                 String?
  createdAt            DateTime   @default(now())
}

model Subscription {
  id                   String         @id @default(cuid())
  fanId                String
  fan                  User           @relation("FanSubscriptions", fields: [fanId], references: [id])
  creatorId            String
  creator              CreatorProfile @relation("CreatorSubscriptions", fields: [creatorId], references: [id])
  tier                 String         @default("VIP") // BASIC, VIP, DIAMOND
  creditCostMonthly    Int            @default(200)
  status               String         @default("ACTIVE") // ACTIVE, CANCELED, EXPIRED
  currentPeriodEnd     DateTime
  createdAt            DateTime       @default(now())
}

model PPVContent {
  id                   String         @id @default(cuid())
  creatorId            String
  creator              CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  previewUrl           String         // Watermarked/blurred preview
  mediaUrl             String         // Secure S3/R2 signed URL
  creditPrice          Int            // e.g. 150 credits
  mediaType            String         @default("VIDEO") // PHOTO, VIDEO, ALBUM
  isLocked             Boolean        @default(true)
  createdAt            DateTime       @default(now())

  purchases            PPVPurchase[]
}

model PPVPurchase {
  id                   String         @id @default(cuid())
  fanId                String
  fan                  User           @relation("FanPurchases", fields: [fanId], references: [id])
  ppvContentId         String
  ppvContent           PPVContent     @relation(fields: [ppvContentId], references: [id])
  creditsPaid          Int
  transactionId        String
  createdAt            DateTime       @default(now())

  @@unique([fanId, ppvContentId])
}

// --------------------------------------------------------------------------
// 4. REAL-TIME ENGINE & LIVESTREAMING
// --------------------------------------------------------------------------

model LiveSession {
  id                   String         @id @default(cuid())
  creatorId            String
  creator              CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title                String
  startedAt            DateTime       @default(now())
  endedAt              DateTime?
  peakViewers          Int            @default(0)
  totalCreditsEarned   Int            @default(0)
  recordingUrl         String?
  status               String         @default("ACTIVE") // ACTIVE, ENDED
}

model ChatMessage {
  id                   String         @id @default(cuid())
  creatorId            String
  creator              CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  senderId             String
  sender               User           @relation(fields: [senderId], references: [id])
  senderName           String
  senderRole           String         @default("FAN")
  senderBadge          String?        // VIP, TOP_TIPPER, MOD
  text                 String
  isTipNotice          Boolean        @default(false)
  tipAmount            Int            @default(0)
  tipActionName        String?
  createdAt            DateTime       @default(now())
}

// --------------------------------------------------------------------------
// 5. TRUST & SAFETY ENGINE (KYC, 2257 COMPLIANCE & MODERATION)
// --------------------------------------------------------------------------

model AgeAssuranceRecord {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  method               String         // CREDIT_CARD_ASSURANCE, ID_DOCUMENT_KYC, FACIAL_AGE_ESTIMATION
  verificationToken    String         @unique
  status               String         @default("APPROVED") // PENDING, APPROVED, REJECTED
  verifiedAt           DateTime       @default(now())
  expiresAt            DateTime
  ipHash               String?
  countryCode          String         @default("US")
}

model Compliance2257Record {
  id                          String         @id @default(cuid())
  creatorId                   String         @unique
  creator                     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  legalFullName               String
  dateOfBirth                 String         // YYYY-MM-DD
  governmentIdType            String         // PASSPORT, DRIVERS_LICENSE, NATIONAL_ID
  idNumberEncrypted           String
  documentVaultUrl            String         // Encrypted S3 secure store
  secondaryCustodianName      String         @default("Platform Legal Records Custodian")
  secondaryCustodianAddress   String         @default("100 Compliance Way, Suite 400, Wilmington, DE")
  verificationStatus          String         @default("APPROVED") // PENDING, APPROVED, REJECTED
  approvedAt                  DateTime?
  createdAt                   DateTime       @default(now())
}

model ModerationReport {
  id                   String         @id @default(cuid())
  reporterId           String
  reporter             User           @relation("ReportedBy", fields: [reporterId], references: [id])
  targetUserId         String?
  targetUser           User?          @relation("ReportedUser", fields: [targetUserId], references: [id])
  targetStreamId       String?
  category             String         // UNDERAGE_SUSPICION, NON_CONSENSUAL, HARASSMENT, FRAUD, COPYRIGHT, OTHER
  notes                String
  status               String         @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  resolutionNotes      String?
  resolvedAt           DateTime?
  createdAt            DateTime       @default(now())
}

model AuditLog {
  id                   String         @id @default(cuid())
  actorId              String?
  actor                User?          @relation(fields: [actorId], references: [id])
  action               String         // e.g. WALLET_ADJUST, CREATOR_BANNED, 2257_APPROVED
  targetType           String         // USER, WALLET, STREAM, TRANSACTION
  targetId             String
  ipAddress            String?
  userAgent            String?
  metadataJson         String?
  createdAt            DateTime       @default(now())
}

// --------------------------------------------------------------------------
// 6. DISCOVERY & RECOMMENDATION TELEMETRY ENGINE
// --------------------------------------------------------------------------

model DiscoveryEvent {
  id               String         @id @default(cuid())
  sessionId        String         // Client browse session ID
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  creatorId        String
  creator          CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  streamId         String?
  eventType        String         // IMPRESSION, WATCH_3S, WATCH_20S, WATCH_90S, WATCH_DURATION, IMMEDIATE_BOUNCE, FOLLOW, UNFOLLOW, INTERACTION_MENU_OPEN, STREAM_ENTER, STREAM_LEAVE, CHAT_OPEN, GIFT_OPEN, PPV_OPEN, LIKE, TIP
  dwellTimeMs      Int            @default(0)
  category         String?
  positionIndex    Int?           // Rank in the feed batch
  metadataJson     String?        // Extra behavioral signals (e.g. scroll speed, previous creator, audio unmuted)
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([creatorId, eventType])
  @@index([eventType, createdAt])
  @@index([sessionId])
}

// --------------------------------------------------------------------------
// 7. VIDEO SYSTEM & SPECIALIZED STREAMING INFRASTRUCTURE CONTROL PLANE
// --------------------------------------------------------------------------

model MediaRoom {
  id                   String            @id @default(cuid())
  creatorId            String
  creator              CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  roomName             String            @unique
  streamKey            String            @unique @default(cuid())

  // Streaming Infrastructure Endpoints (No video passes through app server!)
  mediaProvider        String            @default("CUSTOM_LIVEKIT_OR_SRS") // LIVEKIT, SRS, CLOUDFLARE_STREAM, LIVEPEER
  rtmpIngestUrl        String            @default("rtmp://ingest.live.platform.local/app")
  whipIngestUrl        String            @default("https://ingest.live.platform.local/whip")
  playbackHlsUrl       String            @default("https://cdn.platform.local/hls")
  playbackWhepUrl      String            @default("https://edge.live.platform.local/whep")
  sfuRoomId            String?

  // WebRTC ICE / STUN / TURN Configuration
  iceServersJson       String?           @default("[{\"urls\":\"stun:stun.l.google.com:19302\"}]")

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  livestreams          VideoLivestream[]
  private1on1Sessions  Private1on1Session[]
}

model AudienceRule {
  id                   String            @id @default(cuid())
  creatorId            String
  creator              CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name                 String            @default("Default Room Policy")

  // Rule matrix
  minAge               Int               @default(18)
  requireAgeAssurance  Boolean           @default(true)
  isSubscribersOnly    Boolean           @default(false)
  minSubscriptionTier  String?           // VIP, DIAMOND
  ticketPriceCredits   Int               @default(0) // 0 = Free public, >0 = PPV Livestream
  isFollowerOnly       Boolean           @default(false)
  slowModeSeconds      Int               @default(0)
  isChatDisabled       Boolean           @default(false)
  geoBlockedCountries  String            @default("") // Comma-separated ISO country codes

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  livestreams          VideoLivestream[]
}

model VideoLivestream {
  id                   String            @id @default(cuid())
  creatorId            String
  creator              CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaRoomId          String
  mediaRoom            MediaRoom         @relation(fields: [mediaRoomId], references: [id], onDelete: Cascade)
  audienceRuleId       String?
  audienceRule         AudienceRule?     @relation(fields: [audienceRuleId], references: [id], onDelete: SetNull)

  title                String
  category             String            @default("Entertainment")
  tags                 String            @default("live,interactive")

  streamMode           String            @default("PUBLIC_BROADCAST") // PUBLIC_BROADCAST, PRIVATE_1ON1, VIP_GROUP
  status               String            @default("IDLE") // IDLE, PROVISIONED, BROADCASTING, PAUSED, ENDED, BANNED

  startedAt            DateTime?
  endedAt              DateTime?

  peakViewers          Int               @default(0)
  totalViews           Int               @default(0)
  totalCreditsEarned   Int               @default(0)

  // Media Server Ingest/Egress Metrics & Session IDs
  mediaSessionId       String?
  recordingUrl         String?
  hlsPlaybackUrl       String?
  whepPlaybackUrl      String?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([creatorId, status])
  @@index([status, startedAt])
}

model Private1on1Session {
  id                   String            @id @default(cuid())
  mediaRoomId          String
  mediaRoom            MediaRoom         @relation(fields: [mediaRoomId], references: [id], onDelete: Cascade)

  creatorUserId        String
  creatorUser          User              @relation("Creator1on1Sessions", fields: [creatorUserId], references: [id])
  fanUserId            String
  fanUser              User              @relation("Fan1on1Sessions", fields: [fanUserId], references: [id])

  status               String            @default("REQUESTED") // REQUESTED, ACCEPTED, CONNECTED, COMPLETED, CANCELLED, REJECTED
  creditRatePerMinute  Int               @default(100) // 100 credits per minute
  totalCreditsCharged  Int               @default(0)

  startedAt            DateTime?
  endedAt              DateTime?
  durationSeconds      Int               @default(0)

  // WebRTC Session Metadata
  creatorSignalingToken String?
  fanSignalingToken     String?
  sfuSessionId          String?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([creatorUserId, status])
  @@index([fanUserId, status])
}


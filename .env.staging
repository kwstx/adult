# ============================================================================
# STAGING ENVIRONMENT CONFIGURATION (.env.staging)
# Purpose: Pre-production verification, integration testing, synthetic load & QA
# ============================================================================

NODE_ENV="production"
APP_ENV="staging"
PORT=3000
NEXT_PUBLIC_APP_NAME="AuraLive (Staging)"
NEXT_PUBLIC_APP_URL="https://staging.auralive.internal"

# Staging PostgreSQL (Isolated Staging RDS / CloudSQL cluster with SSL)
DATABASE_URL="postgresql://db_staging_app:Secr3tStag1ngPassw0rd!@db-staging.internal:5432/adult_platform_staging?schema=public&sslmode=require"
DATABASE_MAX_CONNECTIONS=25
DATABASE_IDLE_TIMEOUT_MS=20000

# Staging Redis Cluster
REDIS_URL="rediss://redis-staging.internal:6379"
REDIS_KEY_PREFIX="platform:staging:"

# Payment Sandbox (CCBill Test Merchant Sandbox / SegPay Sandbox)
PAYMENT_GATEWAY_PROVIDER="ccbill"
PAYMENT_WEBHOOK_SECRET="whsec_staging_ccbill_sandbox_secret_99887766554433221100"
PLATFORM_FEE_PERCENTAGE=20
ALLOW_MOCK_PAYMENTS="false"
PAYMENT_MERCHANT_ACCOUNT_ID="959999"
PAYMENT_SUB_ACCOUNT_ID="0001"

# Trust & Safety (Persona Sandbox KYC + 2257 Staging Bucket)
AGE_GATE_ENFORCEMENT="true"
KYC_PROVIDER="persona"
KYC_API_KEY="persona_sandbox_key_staging_987654321"
COMPLIANCE_2257_STORAGE_BUCKET="vault-2257-compliance-staging"
COMPLIANCE_STORAGE_ENCRYPTION_KEY="staging_vault_key_0123456789abcdef0123456789abcdef"

# Livestream Infrastructure & Staging CDN
LIVESTREAM_PROVIDER="livekit"
LIVESTREAM_API_KEY="staging_lk_api_key_8833"
LIVESTREAM_API_SECRET="staging_lk_secret_key_99448822"
MEDIA_CDN_BASE_URL="https://cdn-staging.auralive.internal"
PROTECTED_MEDIA_STORAGE_BUCKET="protected-ppv-media-staging"

# Staging Security Controls
SESSION_SECRET="staging_session_hmac_secret_key_strictly_non_prod_32char"
ENABLE_DEBUG_ENDPOINTS="false"
ALLOW_DATA_MUTATION_SCRIPTS="true"
ENABLE_AUDIT_LOG_STREAMING="true"

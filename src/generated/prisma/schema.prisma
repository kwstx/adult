// ============================================================================
// AUTHORITATIVE POSTGRESQL DATABASE SCHEMA
// Production-Grade Schema for Creator Streaming, Economy & Trust Platform
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================================
// 1. IDENTITY & USER ACCOUNTS
// ============================================================================

model User {
  id              String                 @id @default(uuid())
  email           String                 @unique
  username        String                 @unique
  displayName     String                 @map("display_name")
  avatarUrl       String?                @map("avatar_url")
  bannerUrl       String?                @map("banner_url")
  bio             String?
  role            UserRole               @default(FAN)
  kycStatus       KYCStatus              @default(UNVERIFIED) @map("kyc_status")
  moderationState AccountModerationState @default(ACTIVE) @map("moderation_state")
  isActive        Boolean                @default(true) @map("is_active")
  isBanned        Boolean                @default(false) @map("is_banned")
  banReason       String?                @map("ban_reason")
  lastSeenAt      DateTime?              @map("last_seen_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  // Core 1:1 Relations
  wallet         Wallet?
  creatorProfile CreatorProfile?

  // Engagements & Social
  creatorVerifications    CreatorVerification[]  @relation("UserVerifications")
  followsGiven            Follow[]               @relation("UserFollows")
  subscriptionsFan        Subscription[]         @relation("FanSubscriptions")
  subscriptionPaymentsFan SubscriptionPayment[]  @relation("FanSubscriptionPayments")
  contentPurchases        ContentPurchase[]      @relation("UserPurchases")
  jointProductPurchases   JointProductPurchase[] @relation("UserJointPurchases")
  jointEventTickets       JointEventTicket[]     @relation("UserJointTickets")

  // Direct Messaging
  sentMessages           Message[]      @relation("SentMessages")
  receivedMessages       Message[]      @relation("ReceivedMessages")
  conversationsInitiated Conversation[] @relation("ConversationInitiator")
  conversationsReceived  Conversation[] @relation("ConversationRecipient")

  // Real-time Livestreams & Interactions
  livestreamParticipants LivestreamParticipant[]
  interactionPurchases   InteractionPurchase[]   @relation("FanInteractionPurchases")
  goalContributions      GoalContribution[]      @relation("FanGoalContributions")
  seatsOccupied          Seat[]                  @relation("UserOccupiedSeats")

  // Gamification, Relationships & XP
  creatorRelationshipsFan CreatorRelationship[] @relation("FanCreatorRelationships")
  relationshipXpEvents    RelationshipXPEvent[] @relation("FanRelationshipXPEvents")
  platformXpEvents        PlatformXPEvent[]
  userAchievements        UserAchievement[]
  leaderboardRecords      LeaderboardRecord[]
  gameSessionsWon         GameSession[]         @relation("WinnerGameSessions")
  gameRewards             GameReward[]

  // Private Sessions & Bookings
  bookingsAsFan Booking[] @relation("FanBookings")

  // Payments & Financials
  paymentTransactions PaymentTransaction[]

  // Trust, Safety & Compliance
  ageAssuranceRecords     AgeAssuranceRecord[]
  reportsSubmitted        Report[]              @relation("ReportedBy")
  reportsReceived         Report[]              @relation("ReportedUser")
  moderationCasesTarget   ModerationCase[]      @relation("TargetUserCases")
  moderationCasesReported ModerationCase[]      @relation("ReporterUserCases")
  moderatorCasesAssigned  ModerationCase[]      @relation("ModeratorAssignedCases")
  reviewedVerifications   CreatorVerification[] @relation("AdminVerifier")
  reviewedPayouts         Payout[]              @relation("AdminPayoutReviewer")
  auditEventsActor        AuditEvent[]          @relation("ActorAuditEvents")
  notifications           Notification[]        @relation("UserNotifications")
  notificationsSent       Notification[]        @relation("NotificationSender")
  recommendationEvents    RecommendationEvent[]

  // Fraud & Risk Prevention
  riskAssessments    RiskAssessmentRecord[]
  deviceFingerprints DeviceFingerprintRecord[]
  walletHolds        WalletHold[]

  // Affiliate & Referrals
  referralAttributionReferred  ReferralAttribution?        @relation("ReferredUser")
  referralTouchpoints          ReferralTouchpoint[]        @relation("TouchpointUser")
  affiliateCommissionsReferred AffiliateCommissionLedger[] @relation("ReferredFanCommissions")

  @@index([role])
  @@index([kycStatus])
  @@index([moderationState])
  @@index([isBanned])
  @@index([createdAt])
  @@map("users")
}

// ============================================================================
// 2. CREATOR PROFILES & VERIFICATION (2257 COMPLIANCE)
// ============================================================================

model CreatorProfile {
  id                     String                 @id @default(uuid())
  userId                 String                 @unique @map("user_id")
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageName              String?                @map("stage_name")
  bio                    String?
  bannerUrl              String?                @map("banner_url")
  category               String?
  tags                   String                 @default("interactive,live")
  streamKey              String                 @unique @default(uuid()) @map("stream_key")
  ingestUrl              String                 @default("rtmp://live.platform.local/app") @map("ingest_url")
  playbackHlsUrl         String?                @map("playback_hls_url")
  playbackWhepUrl        String?                @map("playback_whep_url")
  isLive                 Boolean                @default(false) @map("is_live")
  moderationState        CreatorModerationState @default(APPLICATION) @map("moderation_state")
  totalFollowers         Int                    @default(0) @map("total_followers")
  totalViews             Int                    @default(0) @map("total_views")
  totalEarnedCredits     BigInt                 @default(0) @map("total_earned_credits")
  defaultMinTip          Int                    @default(0) @map("default_min_tip")
  subscriptionTier1Price Int                    @default(200) @map("subscription_tier1_price")
  subscriptionTier2Price Int                    @default(500) @map("subscription_tier2_price")
  subscriptionTier3Price Int                    @default(1500) @map("subscription_tier3_price")
  customRules            String?                @map("custom_rules")
  paidMessagesEnabled    Boolean                @default(false) @map("paid_messages_enabled")
  messagePriceCredits    Int                    @default(50) @map("message_price_credits")
  allowFreeSubscribers   Boolean                @default(false) @map("allow_free_subscribers")
  allowFreeVip           Boolean                @default(false) @map("allow_free_vip")
  customWelcomeMessage   String?                @map("custom_welcome_message")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  // Associated Business Entities
  verifications                CreatorVerification[]
  followers                    Follow[]                     @relation("CreatorFollowers")
  livestreams                  Livestream[]
  subscriptionProducts         SubscriptionProduct[]        @relation("CreatorSubscriptionProducts")
  subscriptions                Subscription[]               @relation("CreatorSubscriptions")
  subscriptionPayments         SubscriptionPayment[]        @relation("CreatorSubscriptionPayments")
  products                     Product[]
  contents                     Content[]
  earnings                     CreatorEarning[]
  payouts                      Payout[]
  interactionDefinitions       InteractionDefinition[]
  interactionPurchases         InteractionPurchase[]        @relation("CreatorInteractionPurchases")
  collectiveGoals              CollectiveGoal[]
  creatorRelationships         CreatorRelationship[]        @relation("CreatorProfileRelationships")
  relationshipXpEvents         RelationshipXPEvent[]        @relation("CreatorRelationshipXPEvents")
  privateSessionAvailabilities PrivateSessionAvailability[]
  bookings                     Booking[]                    @relation("CreatorBookings")
  gameSessions                 GameSession[]
  leaderboardRecords           LeaderboardRecord[]
  conversations                Conversation[]
  reportsReceived              Report[]                     @relation("ReportedCreator")
  moderationCases              ModerationCase[]             @relation("ReportedCreatorCases")
  recommendationEvents         RecommendationEvent[]
  coStreamSessionsPrimary      CoStreamSession[]            @relation("PrimaryHostCoStreams")
  coStreamParticipations       CoStreamParticipant[]
  jointProductsPrimary         JointProduct[]               @relation("PrimaryProducerJointProducts")
  jointProductCoStars          JointProductCoCreator[]      @relation("CoStarJointProducts")
  jointEventsPrimary           JointEvent[]                 @relation("PrimaryHostJointEvents")
  jointEventCoHosts            JointEventCoHost[]           @relation("CoHostJointEvents")

  // Affiliate & Referrals
  referralCodes                 CreatorReferralCode[]       @relation("CreatorReferralCodes")
  referralTouchpoints           ReferralTouchpoint[]        @relation("CreatorTouchpoints")
  referralAttributionsReferring ReferralAttribution[]       @relation("ReferringCreator")
  affiliateCommissionsEarned    AffiliateCommissionLedger[] @relation("ReferringCreatorCommissions")

  @@index([isLive])
  @@index([moderationState])
  @@index([category])
  @@index([totalFollowers])
  @@map("creator_profiles")
}

model CreatorVerification {
  id                        String             @id @default(uuid())
  creatorProfileId          String             @map("creator_profile_id")
  creatorProfile            CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  userId                    String             @map("user_id")
  user                      User               @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  legalFirstName            String             @map("legal_first_name")
  legalLastName             String             @map("legal_last_name")
  dateOfBirth               DateTime           @map("date_of_birth")
  idType                    GovIdType          @map("id_type")
  idNumberEncrypted         String             @map("id_number_encrypted")
  idDocumentFrontUrl        String             @map("id_document_front_url")
  idDocumentBackUrl         String?            @map("id_document_back_url")
  selfieWithIdUrl           String             @map("selfie_with_id_url")
  secondaryCustodianName    String?            @default("Platform Legal Records Custodian") @map("secondary_custodian_name")
  secondaryCustodianAddress String?            @default("100 Compliance Way, Suite 400, Wilmington, DE") @map("secondary_custodian_address")
  verificationStatus        VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason           String?            @map("rejection_reason")
  verifiedByAdminId         String?            @map("verified_by_admin_id")
  verifiedByAdmin           User?              @relation("AdminVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  verifiedAt                DateTime?          @map("verified_at")
  expiresAt                 DateTime?          @map("expires_at")
  complianceNotes           String?            @map("compliance_notes")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  @@index([creatorProfileId])
  @@index([userId])
  @@index([verificationStatus])
  @@map("creator_verifications")
}

model AgeAssuranceRecord {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method            String // CREDIT_CARD_ASSURANCE, ID_DOCUMENT_KYC, FACIAL_AGE_ESTIMATION
  verificationToken String   @unique @map("verification_token")
  status            String   @default("APPROVED")
  verifiedAt        DateTime @default(now()) @map("verified_at")
  expiresAt         DateTime @map("expires_at")
  ipHash            String?  @map("ip_hash")
  countryCode       String   @default("US") @map("country_code")

  @@index([userId])
  @@index([status])
  @@map("age_assurance_records")
}

// ============================================================================
// 3. SOCIAL & GRAPH (FOLLOWS)
// ============================================================================

model Follow {
  id                   String           @id @default(uuid())
  followerId           String           @map("follower_id")
  follower             User             @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  creatorProfileId     String           @map("creator_profile_id")
  creatorProfile       CreatorProfile   @relation("CreatorFollowers", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  notificationsEnabled Boolean          @default(true) @map("notifications_enabled")
  notificationTier     FollowNotifyTier @default(ALL) @map("notification_tier")
  createdAt            DateTime         @default(now()) @map("created_at")

  @@unique([followerId, creatorProfileId])
  @@index([followerId])
  @@index([creatorProfileId])
  @@map("follows")
}

// ============================================================================
// 4. LIVESTREAMS, PARTICIPANTS & STAGE SEATS
// ============================================================================

model Livestream {
  id                 String         @id @default(uuid())
  creatorProfileId   String         @map("creator_profile_id")
  creatorProfile     CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  category           String         @default("Entertainment")
  tags               String         @default("live,interactive")
  streamMode         StreamMode     @default(PUBLIC_BROADCAST) @map("stream_mode")
  status             StreamStatus   @default(SCHEDULED)
  ticketPriceCredits Int            @default(0) @map("ticket_price_credits")
  mediaRoomId        String?        @map("media_room_id")
  mediaSessionId     String?        @map("media_session_id")
  rtmpIngestUrl      String?        @map("rtmp_ingest_url")
  whipIngestUrl      String?        @map("whip_ingest_url")
  hlsPlaybackUrl     String?        @map("hls_playback_url")
  whepPlaybackUrl    String?        @map("whep_playback_url")
  recordingUrl       String?        @map("recording_url")
  currentViewerCount Int            @default(0) @map("current_viewer_count")
  peakViewerCount    Int            @default(0) @map("peak_viewer_count")
  totalUniqueViewers Int            @default(0) @map("total_unique_viewers")
  totalCreditsEarned Int            @default(0) @map("total_credits_earned")
  scheduledStartAt   DateTime?      @map("scheduled_start_at")
  startedAt          DateTime?      @map("started_at")
  endedAt            DateTime?      @map("ended_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  participants         LivestreamParticipant[]
  seats                Seat[]
  interactionPurchases InteractionPurchase[]
  interactionQueue     InteractionQueueEntry[]
  collectiveGoals      CollectiveGoal[]
  goalContributions    GoalContribution[]
  leaderboardRecords   LeaderboardRecord[]
  gameSessions         GameSession[]
  reports              Report[]
  recommendationEvents RecommendationEvent[]
  coStreamSession      CoStreamSession?

  @@index([creatorProfileId, status])
  @@index([status, startedAt])
  @@map("livestreams")
}

model LivestreamParticipant {
  id                   String                @id @default(uuid())
  livestreamId         String                @map("livestream_id")
  livestream           Livestream            @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  userId               String                @map("user_id")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInStream         ParticipantStreamRole @default(VIEWER) @map("role_in_stream")
  joinedAt             DateTime              @default(now()) @map("joined_at")
  leftAt               DateTime?             @map("left_at")
  watchDurationSeconds Int                   @default(0) @map("watch_duration_seconds")
  creditsSpent         Int                   @default(0) @map("credits_spent")
  chatMessagesCount    Int                   @default(0) @map("chat_messages_count")
  isMuted              Boolean               @default(false) @map("is_muted")
  isBannedFromRoom     Boolean               @default(false) @map("is_banned_from_room")
  ipAddress            String?               @map("ip_address")
  userAgent            String?               @map("user_agent")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([livestreamId, userId])
  @@index([userId, joinedAt])
  @@map("livestream_participants")
}

model Seat {
  id                    String     @id @default(uuid())
  livestreamId          String     @map("livestream_id")
  livestream            Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  seatIndex             Int        @map("seat_index")
  seatTier              SeatTier   @default(VIP_FRONT_ROW) @map("seat_tier")
  currentUserId         String?    @map("current_user_id")
  currentUser           User?      @relation("UserOccupiedSeats", fields: [currentUserId], references: [id], onDelete: SetNull)
  pricePerMinuteCredits Int        @default(0) @map("price_per_minute_credits")
  minimumBidCredits     Int        @default(0) @map("minimum_bid_credits")
  isOccupied            Boolean    @default(false) @map("is_occupied")
  occupiedAt            DateTime?  @map("occupied_at")
  expiresAt             DateTime?  @map("expires_at")
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@unique([livestreamId, seatIndex])
  @@index([livestreamId, isOccupied])
  @@map("seats")
}

model CoStreamSession {
  id                     String                @id @default(uuid())
  livestreamId           String?               @unique @map("livestream_id")
  livestream             Livestream?           @relation(fields: [livestreamId], references: [id], onDelete: SetNull)
  primaryHostId          String                @map("primary_host_id")
  primaryHost            CreatorProfile        @relation("PrimaryHostCoStreams", fields: [primaryHostId], references: [id], onDelete: Cascade)
  title                  String                @default("Co-Livestream Broadcast")
  status                 CoStreamSessionStatus @default(INVITED)
  layoutMode             CoStreamLayoutMode    @default(SIDE_BY_SIDE) @map("layout_mode")
  mediaRoomId            String?               @map("media_room_id")
  totalSplitPercentage   Decimal               @default(1.00) @map("total_split_percentage") @db.Decimal(5, 2)
  platformRakePercentage Decimal               @default(0.20) @map("platform_rake_percentage") @db.Decimal(5, 2)
  totalGrossCredits      Int                   @default(0) @map("total_gross_credits")
  totalPlatformFee       Int                   @default(0) @map("total_platform_fee")
  totalNetCredits        Int                   @default(0) @map("total_net_credits")
  scheduledStartAt       DateTime?             @map("scheduled_start_at")
  startedAt              DateTime?             @map("started_at")
  endedAt                DateTime?             @map("ended_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  participants CoStreamParticipant[]

  @@index([primaryHostId, status])
  @@index([status, startedAt])
  @@map("co_stream_sessions")
}

model CoStreamParticipant {
  id                 String                    @id @default(uuid())
  coStreamSessionId  String                    @map("co_stream_session_id")
  coStreamSession    CoStreamSession           @relation(fields: [coStreamSessionId], references: [id], onDelete: Cascade)
  creatorProfileId   String                    @map("creator_profile_id")
  creatorProfile     CreatorProfile            @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  role               CoStreamParticipantRole   @default(CO_HOST)
  splitPercentage    Decimal                   @default(0.50) @map("split_percentage") @db.Decimal(5, 2)
  status             CoStreamParticipantStatus @default(INVITED)
  whipIngestUrl      String?                   @map("whip_ingest_url")
  webrtcTrackId      String?                   @map("webrtc_track_id")
  isMediaPublished   Boolean                   @default(false) @map("is_media_published")
  isMuted            Boolean                   @default(false) @map("is_muted")
  totalCreditsEarned Int                       @default(0) @map("total_credits_earned")
  joinedAt           DateTime?                 @map("joined_at")
  leftAt             DateTime?                 @map("left_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@unique([coStreamSessionId, creatorProfileId])
  @@index([creatorProfileId, status])
  @@index([coStreamSessionId, status])
  @@map("co_stream_participants")
}

// ============================================================================
// 5. SUBSCRIPTIONS & COMMERCE (PRODUCTS & CONTENT)
// ============================================================================

model SubscriptionProduct {
  id                 String           @id @default(uuid())
  creatorProfileId   String           @map("creator_profile_id")
  creatorProfile     CreatorProfile   @relation("CreatorSubscriptionProducts", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  name               String // e.g. "Fan", "VIP", "Diamond"
  tier               SubscriptionTier @default(VIP)
  tierLevel          Int              @default(1) @map("tier_level")
  description        String?
  priceFiatCents     Int              @map("price_fiat_cents") // e.g. 999 for €9.99, 2499 for €24.99
  currency           String           @default("EUR")
  creditPriceMonthly Int?             @map("credit_price_monthly")
  billingInterval    String           @default("MONTHLY") @map("billing_interval")
  entitlements       String           @default("SUBSCRIBER_CONTENT,SUBSCRIBER_CHAT,SUBSCRIBER_LIVE")
  badgeIconUrl       String?          @map("badge_icon_url")
  badgeColorHex      String?          @default("#9333EA") @map("badge_color_hex")
  isActive           Boolean          @default(true) @map("is_active")
  isArchived         Boolean          @default(false) @map("is_archived")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  @@unique([creatorProfileId, name])
  @@index([creatorProfileId, isActive])
  @@map("subscription_products")
}

model Subscription {
  id               String               @id @default(uuid())
  fanId            String               @map("fan_id")
  fan              User                 @relation("FanSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)
  creatorProfileId String               @map("creator_profile_id")
  creatorProfile   CreatorProfile       @relation("CreatorSubscriptions", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  productId        String?              @map("product_id")
  product          SubscriptionProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tier             SubscriptionTier     @default(VIP)
  tierName         String               @default("Fan") @map("tier_name")
  tierLevel        Int                  @default(1) @map("tier_level")
  status           SubscriptionStatus   @default(ACTIVE)

  // Pricing & Price Grandfathering Rules
  billingPriceCents               Int     @default(999) @map("billing_price_cents")
  billingCurrency                 String  @default("EUR") @map("billing_currency")
  creditPriceMonthly              Int     @default(200) @map("credit_price_monthly")
  isPriceGrandfathered            Boolean @default(false) @map("is_price_grandfathered")
  grandfatheredOriginalPriceCents Int?    @map("grandfathered_original_price_cents")

  // Billing Periods & Renewal Dates
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  renewalDate        DateTime  @map("renewal_date")
  autoRenew          Boolean   @default(true) @map("auto_renew")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")
  cancelReason       String?   @map("cancel_reason")

  // Pausing Support
  isPaused      Boolean   @default(false) @map("is_paused")
  pausedAt      DateTime? @map("paused_at")
  pauseResumeAt DateTime? @map("pause_resume_at")
  pauseReason   String?   @map("pause_reason")

  // Past Due, Grace Period & Dunning Retries
  failedPaymentAttempts Int       @default(0) @map("failed_payment_attempts")
  gracePeriodEndsAt     DateTime? @map("grace_period_ends_at")
  lastPaymentError      String?   @map("last_payment_error")
  lastPaymentAt         DateTime? @map("last_payment_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments SubscriptionPayment[]

  @@unique([fanId, creatorProfileId])
  @@index([fanId, status])
  @@index([creatorProfileId, status])
  @@index([renewalDate, status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id               String               @id @default(uuid())
  subscriptionId   String               @map("subscription_id")
  subscription     Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fanId            String               @map("fan_id")
  fan              User                 @relation("FanSubscriptionPayments", fields: [fanId], references: [id], onDelete: Cascade)
  creatorProfileId String               @map("creator_profile_id")
  creatorProfile   CreatorProfile       @relation("CreatorSubscriptionPayments", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  productId        String?              @map("product_id")
  product          SubscriptionProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Billing cycle info
  billingCycleIndex Int      @default(1) @map("billing_cycle_index")
  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")

  // Amounts & Fees
  amountCents      Int    @map("amount_cents")
  currency         String @default("EUR")
  creditsDeducted  Int?   @map("credits_deducted")
  platformFeeCents Int    @map("platform_fee_cents")
  creatorNetCents  Int    @map("creator_net_cents")

  // Gateway & Tracking
  paymentGateway       PaymentGateway @default(STRIPE) @map("payment_gateway")
  gatewayTransactionId String?        @map("gateway_transaction_id")
  gatewayInvoiceId     String?        @map("gateway_invoice_id")
  idempotencyKey       String         @unique @map("idempotency_key")
  paymentMethod        String?        @map("payment_method")

  // Status & Dunning
  status            SubscriptionPaymentStatus @default(INITIALIZED)
  failureReason     String?                   @map("failure_reason")
  retryCount        Int                       @default(0) @map("retry_count")
  nextRetryAt       DateTime?                 @map("next_retry_at")
  paidAt            DateTime?                 @map("paid_at")
  refundedAt        DateTime?                 @map("refunded_at")
  disputedAt        DateTime?                 @map("disputed_at")
  rawGatewayPayload String?                   @map("raw_gateway_payload")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([subscriptionId, status])
  @@index([fanId, createdAt])
  @@index([creatorProfileId, createdAt])
  @@index([paymentGateway, gatewayTransactionId])
  @@map("subscription_payments")
}

model Product {
  id               String          @id @default(uuid())
  creatorProfileId String?         @map("creator_profile_id")
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  productType      ProductType     @map("product_type")
  priceCredits     Int             @map("price_credits")
  priceFiatCents   Int?            @map("price_fiat_cents")
  currency         String          @default("USD")
  inventoryCount   Int?            @map("inventory_count")
  isActive         Boolean         @default(true) @map("is_active")
  thumbnailUrl     String?         @map("thumbnail_url")
  mediaUrls        String          @default("[]") @map("media_urls")
  metadataJson     String?         @map("metadata_json")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([creatorProfileId, isActive])
  @@index([productType])
  @@map("products")
}

model Content {
  id                   String                 @id @default(uuid())
  creatorProfileId     String                 @map("creator_profile_id")
  creatorProfile       CreatorProfile         @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  contentType          ContentType            @default(VIDEO) @map("content_type")
  accessLevel          ContentAccessLevel     @default(PPV_PURCHASE) @map("access_level")
  moderationState      ContentModerationState @default(PENDING) @map("moderation_state")
  moderationReason     String?                @map("moderation_reason")
  moderatedAt          DateTime?              @map("moderated_at")
  priceCredits         Int                    @default(0) @map("price_credits")
  previewUrl           String?                @map("preview_url")
  mediaUrl             String                 @map("media_url")
  mediaDurationSeconds Int?                   @map("media_duration_seconds")
  fileSizeBytes        BigInt?                @map("file_size_bytes")
  isPublished          Boolean                @default(true) @map("is_published")
  isArchived           Boolean                @default(false) @map("is_archived")
  viewCount            Int                    @default(0) @map("view_count")
  likeCount            Int                    @default(0) @map("like_count")
  purchaseCount        Int                    @default(0) @map("purchase_count")
  publishedAt          DateTime               @default(now()) @map("published_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  purchases            ContentPurchase[]
  reports              Report[]
  moderationCases      ModerationCase[]      @relation("ReportedContentCases")
  recommendationEvents RecommendationEvent[]

  @@index([creatorProfileId, isPublished])
  @@index([accessLevel, publishedAt])
  @@index([moderationState])
  @@map("contents")
}

model ContentPurchase {
  id                  String             @id @default(uuid())
  contentId           String             @map("content_id")
  content             Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  fanId               String             @map("fan_id")
  fan                 User               @relation("UserPurchases", fields: [fanId], references: [id], onDelete: Cascade)
  priceCreditsPaid    Int                @map("price_credits_paid")
  platformFeeCredits  Int                @map("platform_fee_credits")
  creatorNetCredits   Int                @map("creator_net_credits")
  walletTransactionId String?            @map("wallet_transaction_id")
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  accessGrantedAt     DateTime           @default(now()) @map("access_granted_at")
  expiresAt           DateTime?          @map("expires_at")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@unique([contentId, fanId])
  @@index([fanId])
  @@index([contentId])
  @@map("content_purchases")
}

model JointProduct {
  id                     String             @id @default(uuid())
  primaryProducerId      String             @map("primary_producer_id")
  primaryProducer        CreatorProfile     @relation("PrimaryProducerJointProducts", fields: [primaryProducerId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  contentType            ContentType        @default(VIDEO) @map("content_type")
  priceCredits           Int                @default(0) @map("price_credits")
  previewUrl             String?            @map("preview_url")
  mediaUrl               String             @map("media_url")
  mediaDurationSeconds   Int?               @map("media_duration_seconds")
  status                 JointProductStatus @default(DRAFT)
  is2257Compliant        Boolean            @default(false) @map("is_2257_compliant")
  platformRakePercentage Decimal            @default(0.20) @map("platform_rake_percentage") @db.Decimal(5, 2)
  totalPurchasesCount    Int                @default(0) @map("total_purchases_count")
  totalCreditsEarned     Int                @default(0) @map("total_credits_earned")
  publishedAt            DateTime?          @map("published_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  coCreators JointProductCoCreator[]
  purchases  JointProductPurchase[]

  @@index([primaryProducerId, status])
  @@index([status, publishedAt])
  @@map("joint_products")
}

model JointProductCoCreator {
  id                     String              @id @default(uuid())
  jointProductId         String              @map("joint_product_id")
  jointProduct           JointProduct        @relation(fields: [jointProductId], references: [id], onDelete: Cascade)
  creatorProfileId       String              @map("creator_profile_id")
  creatorProfile         CreatorProfile      @relation("CoStarJointProducts", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  role                   CoCreatorRole       @default(CO_STAR)
  revenueSplitPercentage Decimal             @default(0.50) @map("revenue_split_percentage") @db.Decimal(5, 2)
  approvalStatus         JointApprovalStatus @default(PENDING) @map("approval_status")
  is2257Verified         Boolean             @default(false) @map("is_2257_verified")
  approvedAt             DateTime?           @map("approved_at")
  rejectionReason        String?             @map("rejection_reason")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@unique([jointProductId, creatorProfileId])
  @@index([creatorProfileId, approvalStatus])
  @@map("joint_product_co_creators")
}

model JointEvent {
  id                     String           @id @default(uuid())
  primaryHostId          String           @map("primary_host_id")
  primaryHost            CreatorProfile   @relation("PrimaryHostJointEvents", fields: [primaryHostId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  ticketPriceCredits     Int              @default(0) @map("ticket_price_credits")
  coverImageUrl          String?          @map("cover_image_url")
  scheduledStartAt       DateTime         @map("scheduled_start_at")
  scheduledEndAt         DateTime?        @map("scheduled_end_at")
  status                 JointEventStatus @default(SCHEDULED)
  mediaRoomId            String?          @map("media_room_id")
  is2257Compliant        Boolean          @default(false) @map("is_2257_compliant")
  platformRakePercentage Decimal          @default(0.20) @map("platform_rake_percentage") @db.Decimal(5, 2)
  totalTicketsSold       Int              @default(0) @map("total_tickets_sold")
  totalCreditsEarned     Int              @default(0) @map("total_credits_earned")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  coHosts JointEventCoHost[]
  tickets JointEventTicket[]

  @@index([primaryHostId, status])
  @@index([scheduledStartAt, status])
  @@map("joint_events")
}

model JointEventCoHost {
  id                     String              @id @default(uuid())
  jointEventId           String              @map("joint_event_id")
  jointEvent             JointEvent          @relation(fields: [jointEventId], references: [id], onDelete: Cascade)
  creatorProfileId       String              @map("creator_profile_id")
  creatorProfile         CreatorProfile      @relation("CoHostJointEvents", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  role                   CoCreatorRole       @default(CO_HOST)
  revenueSplitPercentage Decimal             @default(0.50) @map("revenue_split_percentage") @db.Decimal(5, 2)
  approvalStatus         JointApprovalStatus @default(PENDING) @map("approval_status")
  is2257Verified         Boolean             @default(false) @map("is_2257_verified")
  approvedAt             DateTime?           @map("approved_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@unique([jointEventId, creatorProfileId])
  @@index([creatorProfileId, approvalStatus])
  @@map("joint_event_co_hosts")
}

model JointProductPurchase {
  id                  String       @id @default(uuid())
  jointProductId      String       @map("joint_product_id")
  jointProduct        JointProduct @relation(fields: [jointProductId], references: [id], onDelete: Cascade)
  fanId               String       @map("fan_id")
  fan                 User         @relation("UserJointPurchases", fields: [fanId], references: [id], onDelete: Cascade)
  priceCreditsPaid    Int          @map("price_credits_paid")
  platformFeeCredits  Int          @map("platform_fee_credits")
  netCreatorCredits   Int          @map("net_creator_credits")
  walletTransactionId String?      @map("wallet_transaction_id")
  accessGrantedAt     DateTime     @default(now()) @map("access_granted_at")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@unique([jointProductId, fanId])
  @@index([fanId])
  @@index([jointProductId])
  @@map("joint_product_purchases")
}

model JointEventTicket {
  id                     String     @id @default(uuid())
  jointEventId           String     @map("joint_event_id")
  jointEvent             JointEvent @relation(fields: [jointEventId], references: [id], onDelete: Cascade)
  fanId                  String     @map("fan_id")
  fan                    User       @relation("UserJointTickets", fields: [fanId], references: [id], onDelete: Cascade)
  ticketPriceCreditsPaid Int        @map("ticket_price_credits_paid")
  platformFeeCredits     Int        @map("platform_fee_credits")
  netCreatorCredits      Int        @map("net_creator_credits")
  walletTransactionId    String?    @map("wallet_transaction_id")
  accessPassToken        String?    @map("access_pass_token")
  isUsed                 Boolean    @default(false) @map("is_used")
  usedAt                 DateTime?  @map("used_at")
  createdAt              DateTime   @default(now()) @map("created_at")

  @@unique([jointEventId, fanId])
  @@index([fanId])
  @@index([jointEventId])
  @@map("joint_event_tickets")
}

// ============================================================================
// 6. MESSAGING & CONVERSATIONS
// ============================================================================

model Conversation {
  id                 String           @id @default(uuid())
  conversationType   ConversationType @default(DIRECT_DM) @map("conversation_type")
  title              String?
  creatorProfileId   String?          @map("creator_profile_id")
  creatorProfile     CreatorProfile?  @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  initiatorUserId    String           @map("initiator_user_id")
  initiatorUser      User             @relation("ConversationInitiator", fields: [initiatorUserId], references: [id], onDelete: Cascade)
  recipientUserId    String?          @map("recipient_user_id")
  recipientUser      User?            @relation("ConversationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  lastMessageId      String?          @map("last_message_id")
  lastMessagePreview String?          @map("last_message_preview")
  lastActivityAt     DateTime         @default(now()) @map("last_activity_at")
  isArchived         Boolean          @default(false) @map("is_archived")
  isLocked           Boolean          @default(false) @map("is_locked")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  messages Message[]

  @@index([initiatorUserId, lastActivityAt])
  @@index([recipientUserId, lastActivityAt])
  @@index([creatorProfileId])
  @@map("conversations")
}

model Message {
  id                     String            @id @default(uuid())
  conversationId         String            @map("conversation_id")
  conversation           Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId               String            @map("sender_id")
  sender                 User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId            String?           @map("recipient_id")
  recipient              User?             @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  messageType            MessageType       @default(TEXT) @map("message_type")
  body                   String?
  mediaUrl               String?           @map("media_url")
  isPpvLocked            Boolean           @default(false) @map("is_ppv_locked")
  ppvPriceCredits        Int?              @default(0) @map("ppv_price_credits")
  isPpvUnlocked          Boolean           @default(false) @map("is_ppv_unlocked")
  tipCredits             Int?              @default(0) @map("tip_credits")
  isPaidMessage          Boolean           @default(false) @map("is_paid_message")
  paidPriceCredits       Int?              @default(0) @map("paid_price_credits")
  isPriority             Boolean           @default(false) @map("is_priority")
  relationshipTierAtSend RelationshipTier? @map("relationship_tier_at_send")
  fanLevelAtSend         Int?              @map("fan_level_at_send")
  transactionId          String?           @map("transaction_id")
  isRead                 Boolean           @default(false) @map("is_read")
  readAt                 DateTime?         @map("read_at")
  isDeleted              Boolean           @default(false) @map("is_deleted")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  reports                Report[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([recipientId, isRead])
  @@index([isPaidMessage])
  @@index([isPriority])
  @@map("messages")
}

// ============================================================================
// 7. ECONOMIC ENGINE (WALLETS, LEDGER, PAYMENTS, EARNINGS, PAYOUTS)
// ============================================================================

model Wallet {
  id                       String       @id @default(uuid())
  userId                   String       @unique @map("user_id")
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency                 String       @default("CREDITS")
  balance                  Int          @default(0)
  purchasedBalance         Int          @default(0) @map("purchased_balance")
  promotionalBalance       Int          @default(0) @map("promotional_balance")
  bonusBalance             Int          @default(0) @map("bonus_balance")
  lockedBalance            Int          @default(0) @map("locked_balance")
  pendingBalance           Int          @default(0) @map("pending_balance")
  lifetimeDepositedCredits BigInt       @default(0) @map("lifetime_deposited_credits")
  lifetimeEarnedCredits    BigInt       @default(0) @map("lifetime_earned_credits")
  lifetimeSpentCredits     BigInt       @default(0) @map("lifetime_spent_credits")
  lifetimeWithdrawnCredits BigInt       @default(0) @map("lifetime_withdrawn_credits")
  status                   WalletStatus @default(ACTIVE)
  version                  Int          @default(1)
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  creditLots           CreditLot[]
  outgoingTransactions WalletTransaction[]  @relation("SourceWalletTransactions")
  incomingTransactions WalletTransaction[]  @relation("DestWalletTransactions")
  paymentTransactions  PaymentTransaction[]
  walletHolds          WalletHold[]

  @@index([userId, status])
  @@map("wallets")
}

model CreditLot {
  id                   String          @id @default(uuid())
  walletId             String          @map("wallet_id")
  wallet               Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  creditType           CreditType      @default(PURCHASED) @map("credit_type")
  originalAmount       Int             @map("original_amount")
  remainingAmount      Int             @map("remaining_amount")
  fiatValueCents       Int?            @map("fiat_value_cents")
  fiatCurrency         String          @default("USD") @map("fiat_currency")
  expiresAt            DateTime?       @map("expires_at")
  grantReason          String?         @map("grant_reason")
  paymentTransactionId String?         @map("payment_transaction_id")
  status               CreditLotStatus @default(ACTIVE)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  deductions CreditLotDeduction[]

  @@index([walletId, status])
  @@index([walletId, expiresAt])
  @@index([creditType, status])
  @@map("credit_lots")
}

model CreditLotDeduction {
  id                  String            @id @default(uuid())
  creditLotId         String            @map("credit_lot_id")
  creditLot           CreditLot         @relation(fields: [creditLotId], references: [id], onDelete: Cascade)
  walletTransactionId String            @map("wallet_transaction_id")
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id], onDelete: Cascade)
  amountDeducted      Int               @map("amount_deducted")
  creditType          CreditType        @map("credit_type")
  createdAt           DateTime          @default(now()) @map("created_at")

  @@index([creditLotId])
  @@index([walletTransactionId])
  @@map("credit_lot_deductions")
}

model WalletTransaction {
  id                  String                  @id @default(uuid())
  sourceWalletId      String?                 @map("source_wallet_id")
  sourceWallet        Wallet?                 @relation("SourceWalletTransactions", fields: [sourceWalletId], references: [id], onDelete: SetNull)
  destinationWalletId String?                 @map("destination_wallet_id")
  destinationWallet   Wallet?                 @relation("DestWalletTransactions", fields: [destinationWalletId], references: [id], onDelete: SetNull)
  transactionType     WalletTransactionType   @map("transaction_type")
  direction           TransactionDirection    @default(TRANSFER)
  amountCredits       Int                     @map("amount_credits")
  primaryCreditType   CreditType?             @map("primary_credit_type")
  platformFeeCredits  Int                     @default(0) @map("platform_fee_credits")
  creatorNetCredits   Int                     @default(0) @map("creator_net_credits")
  sourceBalanceBefore Int?                    @map("source_balance_before")
  sourceBalanceAfter  Int?                    @map("source_balance_after")
  destBalanceBefore   Int?                    @map("dest_balance_before")
  destBalanceAfter    Int?                    @map("dest_balance_after")
  idempotencyKey      String                  @unique @map("idempotency_key")
  referenceType       String?                 @map("reference_type")
  referenceId         String?                 @map("reference_id")
  status              WalletTransactionStatus @default(COMPLETED)
  note                String?
  metadataJson        String?                 @map("metadata_json")
  createdAt           DateTime                @default(now()) @map("created_at")

  creditLotDeductions CreditLotDeduction[]
  contentPurchases    ContentPurchase[]
  creatorEarnings     CreatorEarning[]
  bookings            Booking[]

  @@index([sourceWalletId, createdAt])
  @@index([destinationWalletId, createdAt])
  @@index([transactionType, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model PaymentTransaction {
  id                   String                   @id @default(uuid())
  userId               String                   @map("user_id")
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId             String                   @map("wallet_id")
  wallet               Wallet                   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentGateway       PaymentGateway           @map("payment_gateway")
  gatewayTransactionId String?                  @map("gateway_transaction_id")
  gatewayEventId       String?                  @map("gateway_event_id")
  idempotencyKey       String                   @unique @map("idempotency_key")
  amountFiatCents      Int                      @map("amount_fiat_cents")
  currency             String                   @default("USD")
  creditsPurchased     Int                      @map("credits_purchased")
  bonusCredits         Int                      @default(0) @map("bonus_credits")
  gatewayFeeCents      Int                      @default(0) @map("gateway_fee_cents")
  paymentMethod        String?                  @map("payment_method")
  status               PaymentTransactionStatus @default(INITIALIZED)
  riskScore            Int?                     @map("risk_score")
  ipAddress            String?                  @map("ip_address")
  countryCode          String?                  @map("country_code")
  rawGatewayPayload    String?                  @map("raw_gateway_payload")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([paymentGateway, gatewayTransactionId])
  @@map("payment_transactions")
}

model CreatorEarning {
  id                      String                 @id @default(uuid())
  creatorProfileId        String                 @map("creator_profile_id")
  creatorProfile          CreatorProfile         @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  walletTransactionId     String?                @map("wallet_transaction_id")
  walletTransaction       WalletTransaction?     @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  earningSource           EarningSourceType      @map("earning_source")
  sourceReferenceId       String?                @map("source_reference_id")
  grossCredits            Int                    @map("gross_credits")
  platformRakePercentage  Decimal                @default(0.20) @map("platform_rake_percentage") @db.Decimal(5, 2)
  platformFeeCredits      Int                    @map("platform_fee_credits")
  netCreatorCredits       Int                    @map("net_creator_credits")
  fiatValueEstimatedCents Int                    @map("fiat_value_estimated_cents")
  clearanceStatus         EarningClearanceStatus @default(CLEARED) @map("clearance_status")
  clearsAt                DateTime?              @map("clears_at")
  createdAt               DateTime               @default(now()) @map("created_at")

  @@index([creatorProfileId, clearanceStatus])
  @@index([earningSource, createdAt])
  @@map("creator_earnings")
}

model Payout {
  id                    String         @id @default(uuid())
  creatorProfileId      String         @map("creator_profile_id")
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  amountFiatCents       Int            @map("amount_fiat_cents")
  creditsDeducted       Int            @map("credits_deducted")
  currency              String         @default("USD")
  payoutMethod          PayoutMethod   @map("payout_method")
  payoutBeneficiaryInfo String         @map("payout_beneficiary_info") // Encrypted / tokenized
  status                PayoutStatus   @default(REQUESTED)
  gatewayReferenceId    String?        @map("gateway_reference_id")
  failureReason         String?        @map("failure_reason")
  reviewedByAdminId     String?        @map("reviewed_by_admin_id")
  reviewedByAdmin       User?          @relation("AdminPayoutReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  requestedAt           DateTime       @default(now()) @map("requested_at")
  reviewedAt            DateTime?      @map("reviewed_at")
  completedAt           DateTime?      @map("completed_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@index([creatorProfileId, status])
  @@index([status, requestedAt])
  @@map("payouts")
}

// ============================================================================
// 8. INTERACTION ENGINE (DEFINITIONS, PURCHASES, QUEUES)
// ============================================================================

model InteractionDefinition {
  id                String                @id @default(uuid())
  creatorProfileId  String                @map("creator_profile_id")
  creatorProfile    CreatorProfile        @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  actionType        InteractionActionType @default(TIP_ALERT) @map("action_type")
  priceCredits      Int                   @map("price_credits")
  durationSeconds   Int                   @default(0) @map("duration_seconds")
  intensityLevel    Int?                  @map("intensity_level")
  toyCommandPattern String?               @map("toy_command_pattern")
  soundAssetUrl     String?               @map("sound_asset_url")
  iconUrl           String?               @map("icon_url")
  cooldownSeconds   Int                   @default(0) @map("cooldown_seconds")
  isEnabled         Boolean               @default(true) @map("is_enabled")
  sortOrder         Int                   @default(0) @map("sort_order")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  purchases InteractionPurchase[]

  @@index([creatorProfileId, isEnabled])
  @@map("interaction_definitions")
}

model InteractionPurchase {
  id                      String                    @id @default(uuid())
  livestreamId            String?                   @map("livestream_id")
  livestream              Livestream?               @relation(fields: [livestreamId], references: [id], onDelete: SetNull)
  creatorProfileId        String                    @map("creator_profile_id")
  creatorProfile          CreatorProfile            @relation("CreatorInteractionPurchases", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  fanId                   String                    @map("fan_id")
  fan                     User                      @relation("FanInteractionPurchases", fields: [fanId], references: [id], onDelete: Cascade)
  interactionDefinitionId String                    @map("interaction_definition_id")
  interactionDefinition   InteractionDefinition     @relation(fields: [interactionDefinitionId], references: [id], onDelete: Cascade)
  priceCreditsPaid        Int                       @map("price_credits_paid")
  customMessage           String?                   @map("custom_message")
  toyIntensity            Int?                      @map("toy_intensity")
  status                  InteractionPurchaseStatus @default(PAID)
  executedAt              DateTime?                 @map("executed_at")
  createdAt               DateTime                  @default(now()) @map("created_at")

  queueEntry InteractionQueueEntry?

  @@index([livestreamId, status])
  @@index([creatorProfileId, createdAt])
  @@index([fanId])
  @@map("interaction_purchases")
}

model InteractionQueueEntry {
  id                     String              @id @default(uuid())
  livestreamId           String              @map("livestream_id")
  livestream             Livestream          @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  interactionPurchaseId  String              @unique @map("interaction_purchase_id")
  interactionPurchase    InteractionPurchase @relation(fields: [interactionPurchaseId], references: [id], onDelete: Cascade)
  queuePosition          Int                 @map("queue_position")
  status                 QueueEntryStatus    @default(PENDING)
  scheduledExecutionTime DateTime?           @map("scheduled_execution_time")
  startedPlayingAt       DateTime?           @map("started_playing_at")
  completedAt            DateTime?           @map("completed_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@index([livestreamId, status, queuePosition])
  @@map("interaction_queue_entries")
}

// ============================================================================
// 9. COLLECTIVE GOALS & CONTRIBUTIONS
// ============================================================================

model CollectiveGoal {
  id                String         @id @default(uuid())
  livestreamId      String?        @map("livestream_id")
  livestream        Livestream?    @relation(fields: [livestreamId], references: [id], onDelete: SetNull)
  creatorProfileId  String         @map("creator_profile_id")
  creatorProfile    CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  rewardDescription String?        @map("reward_description")
  targetCredits     Int            @map("target_credits")
  currentCredits    Int            @default(0) @map("current_credits")
  contributorCount  Int            @default(0) @map("contributor_count")
  status            GoalStatus     @default(ACTIVE)
  startedAt         DateTime       @default(now()) @map("started_at")
  endsAt            DateTime?      @map("ends_at")
  reachedAt         DateTime?      @map("reached_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  contributions GoalContribution[]

  @@index([creatorProfileId, status])
  @@index([livestreamId, status])
  @@map("collective_goals")
}

model GoalContribution {
  id               String         @id @default(uuid())
  collectiveGoalId String         @map("collective_goal_id")
  collectiveGoal   CollectiveGoal @relation(fields: [collectiveGoalId], references: [id], onDelete: Cascade)
  livestreamId     String?        @map("livestream_id")
  livestream       Livestream?    @relation(fields: [livestreamId], references: [id], onDelete: SetNull)
  fanId            String         @map("fan_id")
  fan              User           @relation("FanGoalContributions", fields: [fanId], references: [id], onDelete: Cascade)
  amountCredits    Int            @map("amount_credits")
  message          String?
  isAnonymous      Boolean        @default(false) @map("is_anonymous")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([collectiveGoalId, createdAt])
  @@index([fanId])
  @@map("goal_contributions")
}

// ============================================================================
// 10. CREATOR RELATIONSHIPS, PROGRESSION & XP
// ============================================================================

model CreatorRelationship {
  id                  String           @id @default(uuid())
  fanId               String           @map("fan_id")
  fan                 User             @relation("FanCreatorRelationships", fields: [fanId], references: [id], onDelete: Cascade)
  creatorProfileId    String           @map("creator_profile_id")
  creatorProfile      CreatorProfile   @relation("CreatorProfileRelationships", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  relationshipTier    RelationshipTier @default(STRANGER) @map("relationship_tier")
  currentLevel        Int              @default(1) @map("current_level")
  totalXp             BigInt           @default(0) @map("total_xp")
  totalCreditsSpent   BigInt           @default(0) @map("total_credits_spent")
  totalMinutesWatched Int              @default(0) @map("total_minutes_watched")
  currentStreakDays   Int              @default(0) @map("current_streak_days")
  longestStreakDays   Int              @default(0) @map("longest_streak_days")
  lastInteractedAt    DateTime         @default(now()) @map("last_interacted_at")
  customNickname      String?          @map("custom_nickname")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  xpEvents RelationshipXPEvent[]

  @@unique([fanId, creatorProfileId])
  @@index([fanId])
  @@index([creatorProfileId, totalCreditsSpent])
  @@map("creator_relationships")
}

model RelationshipXPEvent {
  id                    String              @id @default(uuid())
  creatorRelationshipId String              @map("creator_relationship_id")
  creatorRelationship   CreatorRelationship @relation(fields: [creatorRelationshipId], references: [id], onDelete: Cascade)
  fanId                 String              @map("fan_id")
  fan                   User                @relation("FanRelationshipXPEvents", fields: [fanId], references: [id], onDelete: Cascade)
  creatorProfileId      String              @map("creator_profile_id")
  creatorProfile        CreatorProfile      @relation("CreatorRelationshipXPEvents", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  eventType             RelationshipXPType  @map("event_type")
  xpAwarded             Int                 @map("xp_awarded")
  creditsMultiplier     Float               @default(1.0) @map("credits_multiplier")
  metadataJson          String?             @map("metadata_json")
  createdAt             DateTime            @default(now()) @map("created_at")

  @@index([creatorRelationshipId, createdAt])
  @@index([fanId, createdAt])
  @@map("relationship_xp_events")
}

model PlatformXPEvent {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      PlatformXPType @map("event_type")
  xpAwarded      Int            @map("xp_awarded")
  userLevelAfter Int            @map("user_level_after")
  metadataJson   String?        @map("metadata_json")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("platform_xp_events")
}

// ============================================================================
// 11. ACHIEVEMENTS & LEADERBOARDS
// ============================================================================

model Achievement {
  id                   String              @id @default(uuid())
  code                 String              @unique
  name                 String
  description          String
  category             AchievementCategory @default(FAN_LOYALTY)
  badgeIconUrl         String              @map("badge_icon_url")
  badgeTier            BadgeTier           @default(BRONZE) @map("badge_tier")
  xpReward             Int                 @default(100) @map("xp_reward")
  creditBonusReward    Int                 @default(0) @map("credit_bonus_reward")
  requirementThreshold Int                 @default(1) @map("requirement_threshold")
  requirementMetric    String              @default("TOTAL_CREDITS_SPENT") @map("requirement_metric")
  isHidden             Boolean             @default(false) @map("is_hidden")
  createdAt            DateTime            @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@index([category])
  @@map("achievements")
}

model UserAchievement {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId   String      @map("achievement_id")
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  currentProgress Int         @default(0) @map("current_progress")
  isUnlocked      Boolean     @default(false) @map("is_unlocked")
  unlockedAt      DateTime?   @map("unlocked_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([userId, achievementId])
  @@index([userId, isUnlocked])
  @@map("user_achievements")
}

model LeaderboardRecord {
  id                      String               @id @default(uuid())
  scope                   LeaderboardScope     @map("scope")
  timeframe               LeaderboardTimeframe @map("timeframe")
  periodKey               String               @map("period_key") // e.g., '2026-W36', '2026-09', 'ALL'
  creatorProfileId        String?              @map("creator_profile_id")
  creatorProfile          CreatorProfile?      @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  livestreamId            String?              @map("livestream_id")
  livestream              Livestream?          @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  userId                  String               @map("user_id")
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank                    Int
  totalCreditsContributed BigInt               @default(0) @map("total_credits_contributed")
  totalXpEarned           BigInt               @default(0) @map("total_xp_earned")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  @@unique([scope, timeframe, periodKey, creatorProfileId, livestreamId, userId])
  @@index([scope, timeframe, periodKey, rank])
  @@map("leaderboard_records")
}

// ============================================================================
// 12. PRIVATE SESSIONS & BOOKINGS
// ============================================================================

model PrivateSessionAvailability {
  id                  String         @id @default(uuid())
  creatorProfileId    String         @map("creator_profile_id")
  creatorProfile      CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek           Int            @map("day_of_week") // 0 = Sunday, 6 = Saturday
  startTimeUtc        String         @map("start_time_utc") // e.g. "14:00"
  endTimeUtc          String         @map("end_time_utc") // e.g. "22:00"
  minDurationMinutes  Int            @default(10) @map("min_duration_minutes")
  maxDurationMinutes  Int            @default(60) @map("max_duration_minutes")
  creditRatePerMinute Int            @default(100) @map("credit_rate_per_minute")
  bufferTimeMinutes   Int            @default(5) @map("buffer_time_minutes")
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([creatorProfileId, isActive])
  @@map("private_session_availabilities")
}

model Booking {
  id                    String             @id @default(uuid())
  creatorProfileId      String             @map("creator_profile_id")
  creatorProfile        CreatorProfile     @relation("CreatorBookings", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  fanId                 String             @map("fan_id")
  fan                   User               @relation("FanBookings", fields: [fanId], references: [id], onDelete: Cascade)
  scheduledStartTime    DateTime           @map("scheduled_start_time")
  scheduledEndTime      DateTime           @map("scheduled_end_time")
  durationMinutes       Int                @map("duration_minutes")
  creditRatePerMinute   Int                @map("credit_rate_per_minute")
  totalCreditsEscrowed  Int                @map("total_credits_escrowed")
  status                BookingStatus      @default(PENDING_CREATOR_ACCEPT)
  meetingRoomId         String?            @map("meeting_room_id")
  fanNotes              String?            @map("fan_notes")
  creatorNotes          String?            @map("creator_notes")
  actualStartedAt       DateTime?          @map("actual_started_at")
  actualEndedAt         DateTime?          @map("actual_ended_at")
  actualDurationSeconds Int?               @map("actual_duration_seconds")
  walletTransactionId   String?            @map("wallet_transaction_id")
  walletTransaction     WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@index([creatorProfileId, status])
  @@index([fanId, status])
  @@index([scheduledStartTime])
  @@map("bookings")
}

// ============================================================================
// 13. TRUST, SAFETY, REPORTS & MODERATION
// ============================================================================

model Report {
  id                       String          @id @default(uuid())
  reporterId               String          @map("reporter_id")
  reporter                 User            @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId           String?         @map("reported_user_id")
  reportedUser             User?           @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedCreatorProfileId String?         @map("reported_creator_profile_id")
  reportedCreatorProfile   CreatorProfile? @relation("ReportedCreator", fields: [reportedCreatorProfileId], references: [id], onDelete: SetNull)
  reportedContentId        String?         @map("reported_content_id")
  reportedContent          Content?        @relation(fields: [reportedContentId], references: [id], onDelete: SetNull)
  reportedLivestreamId     String?         @map("reported_livestream_id")
  reportedLivestream       Livestream?     @relation(fields: [reportedLivestreamId], references: [id], onDelete: SetNull)
  reportedMessageId        String?         @map("reported_message_id")
  reportedMessage          Message?        @relation(fields: [reportedMessageId], references: [id], onDelete: SetNull)
  category                 ReportCategory
  description              String
  evidenceUrls             String?         @map("evidence_urls") // JSON array of urls
  status                   ReportStatus    @default(OPEN)
  assignedModeratorId      String?         @map("assigned_moderator_id")
  moderatorNotes           String?         @map("moderator_notes")
  resolvedAt               DateTime?       @map("resolved_at")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  moderationCases ModerationCase[]

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([reporterId])
  @@map("reports")
}

model ModerationCase {
  id             String  @id @default(uuid())
  caseNumber     String  @unique @map("case_number")
  sourceReportId String? @map("source_report_id")
  sourceReport   Report? @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)

  // Reported Object (Polymorphic target object tracking)
  reportedObjectType       ReportedObjectType @default(ACCOUNT) @map("reported_object_type")
  reportedObjectId         String             @map("reported_object_id")
  reportedContentId        String?            @map("reported_content_id")
  reportedContent          Content?           @relation("ReportedContentCases", fields: [reportedContentId], references: [id], onDelete: SetNull)
  reportedUserId           String?            @map("reported_user_id")
  reportedUser             User?              @relation("TargetUserCases", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedCreatorProfileId String?            @map("reported_creator_profile_id")
  reportedCreatorProfile   CreatorProfile?    @relation("ReportedCreatorCases", fields: [reportedCreatorProfileId], references: [id], onDelete: SetNull)

  // Reporter
  reporterId   String? @map("reporter_id")
  reporter     User?   @relation("ReporterUserCases", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterType String  @default("USER") @map("reporter_type") // USER, SYSTEM, EXTERNAL, ANONYMOUS

  // Reason & Evidence
  reasonCategory ReportCategory @default(OTHER) @map("reason_category")
  reason         String
  evidence       String?        @map("evidence_json") // JSON structured evidence attachments

  // Automated Signals
  automatedSignals String? @map("automated_signals_json") // JSON signals: AI scores, spam risk, hashes, etc.

  // Reviewer & Decision
  reviewerId          String?              @map("reviewer_id")
  reviewer            User?                @relation("ModeratorAssignedCases", fields: [reviewerId], references: [id], onDelete: SetNull)
  priority            ModerationPriority   @default(MEDIUM)
  status              ModerationCaseStatus @default(OPEN)
  actionTaken         ModerationActionType @default(NONE) @map("action_taken")
  decision            String?              @map("decision")
  decisionNotes       String?              @map("decision_notes")
  decisionTime        DateTime?            @map("decision_time")
  actionDurationHours Int?                 @map("action_duration_hours")

  // Appeal Status & Lifecycle
  appealStatus        AppealStatus @default(NONE) @map("appeal_status")
  appealReason        String?      @map("appeal_reason")
  appealEvidence      String?      @map("appeal_evidence_json")
  appealReviewerId    String?      @map("appeal_reviewer_id")
  appealDecisionTime  DateTime?    @map("appeal_decision_time")
  appealDecisionNotes String?      @map("appeal_decision_notes")

  summaryFindings String?   @map("summary_findings")
  internalNotes   String?   @map("internal_notes")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, priority])
  @@index([reportedObjectType, reportedObjectId])
  @@index([reportedUserId])
  @@index([reportedContentId])
  @@index([reportedCreatorProfileId])
  @@index([appealStatus])
  @@map("moderation_cases")
}

model AuditEvent {
  id               String   @id @default(uuid())
  actorId          String?  @map("actor_id")
  actor            User?    @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)
  actorType        String   @default("USER") @map("actor_type") // USER, MODERATOR, ADMIN, SYSTEM_AUTOMATION, EXTERNAL_WEBHOOK
  action           String // e.g. "CONTENT_STATUS_TRANSITION", "ACCOUNT_MODERATION_ACTION", "CASE_CREATED", "DECISION_RENDERED", "APPEAL_RESOLVED"
  targetEntityType String   @map("target_entity_type") // e.g. "Content", "User", "CreatorProfile", "ModerationCase"
  targetEntityId   String   @map("target_entity_id")
  oldState         String?  @map("old_state")
  newState         String?  @map("new_state")
  oldValues        String?  @map("old_values") // JSON serialized
  newValues        String?  @map("new_values") // JSON serialized
  reason           String?
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  metadataJson     String?  @map("metadata_json")
  hashChecksum     String?  @map("hash_checksum") // SHA256 chain seal
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([targetEntityType, targetEntityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

// ============================================================================
// 14. NOTIFICATIONS
// ============================================================================

model Notification {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  senderUserId String?          @map("sender_user_id")
  senderUser   User?            @relation("NotificationSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  type         NotificationType
  title        String
  body         String
  actionUrl    String?          @map("action_url")
  isRead       Boolean          @default(false) @map("is_read")
  readAt       DateTime?        @map("read_at")
  metadataJson String?          @map("metadata_json")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================================
// 15. INTERACTIVE GAMING & REWARDS
// ============================================================================

model GameSession {
  id                    String            @id @default(uuid())
  livestreamId          String?           @map("livestream_id")
  livestream            Livestream?       @relation(fields: [livestreamId], references: [id], onDelete: SetNull)
  creatorProfileId      String            @map("creator_profile_id")
  creatorProfile        CreatorProfile    @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  gameType              GameType          @map("game_type")
  title                 String
  status                GameSessionStatus @default(LOBBY_WAITING)
  entryCostCredits      Int               @default(0) @map("entry_cost_credits")
  totalPrizePoolCredits Int               @default(0) @map("total_prize_pool_credits")
  winningUserId         String?           @map("winning_user_id")
  winnerUser            User?             @relation("WinnerGameSessions", fields: [winningUserId], references: [id], onDelete: SetNull)
  gameStateJson         String?           @map("game_state_json")
  startedAt             DateTime          @default(now()) @map("started_at")
  endedAt               DateTime?         @map("ended_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  rewards GameReward[]

  @@index([creatorProfileId, status])
  @@index([livestreamId, status])
  @@map("game_sessions")
}

model GameReward {
  id                 String         @id @default(uuid())
  gameSessionId      String         @map("game_session_id")
  gameSession        GameSession    @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  userId             String         @map("user_id")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardType         GameRewardType @map("reward_type")
  rewardValueCredits Int            @default(0) @map("reward_value_credits")
  isClaimed          Boolean        @default(false) @map("is_claimed")
  claimedAt          DateTime?      @map("claimed_at")
  claimMetadata      String?        @map("claim_metadata")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([gameSessionId])
  @@index([userId, isClaimed])
  @@map("game_rewards")
}

// ============================================================================
// 16. RECOMMENDATION ENGINE & TELEMETRY COLLECTION
// ============================================================================

model RecommendationEvent {
  id                   String                  @id @default(uuid())
  sessionId            String                  @map("session_id")
  userId               String?                 @map("user_id")
  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  creatorProfileId     String?                 @map("creator_profile_id")
  creatorProfile       CreatorProfile?         @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  livestreamId         String?                 @map("livestream_id")
  livestream           Livestream?             @relation(fields: [livestreamId], references: [id], onDelete: SetNull)
  contentId            String?                 @map("content_id")
  content              Content?                @relation(fields: [contentId], references: [id], onDelete: SetNull)
  eventType            RecommendationEventType @map("event_type")
  dwellTimeMs          Int                     @default(0) @map("dwell_time_ms")
  watchDurationSeconds Int                     @default(0) @map("watch_duration_seconds")
  searchQuery          String?                 @map("search_query")
  category             String?
  tags                 String?
  amountCredits        Int?                    @map("amount_credits")
  positionIndex        Int?                    @map("position_index")
  deviceType           String?                 @map("device_type")
  metadataJson         String?                 @map("metadata_json")
  createdAt            DateTime                @default(now()) @map("created_at")

  @@index([userId, eventType, createdAt])
  @@index([creatorProfileId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
  @@map("recommendation_events")
}

// ============================================================================
// 17. FRAUD PREVENTION, RISK SCORING & FINANCIAL INTEGRITY
// ============================================================================

model RiskAssessmentRecord {
  id                    String   @id @default(uuid())
  userId                String?  @map("user_id")
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actionType            String   @map("action_type") // e.g. "CREDIT_PURCHASE", "TIP", "PAYOUT", "LOGIN", "SIGNUP", "REFERRAL_CLAIM", "PPV_UNLOCK"
  riskScore             Int      @map("risk_score") // 0 - 100
  riskLevel             String   @map("risk_level") // LOW, MEDIUM, HIGH, CRITICAL
  recommendedAction     String   @map("recommended_action") // ALLOW, CHALLENGE_2FA, CHALLENGE_KYC, DELAY_FULFILLMENT, REQUIRE_MANUAL_REVIEW, BLOCK_TRANSACTION, FREEZE_ACCOUNT
  finalAction           String   @map("final_action")
  ruleTriggersJson      String   @map("rule_triggers_json") // Array of triggers with weights and codes
  signalsJson           String   @map("signals_json") // Evaluated signals snapshot
  contextJson           String?  @map("context_json")
  ipAddress             String?  @map("ip_address")
  userAgent             String?  @map("user_agent")
  deviceFingerprintHash String?  @map("device_fingerprint_hash")
  executionTimeMs       Int      @default(0) @map("execution_time_ms")
  isOverridden          Boolean  @default(false) @map("is_overridden")
  overriddenById        String?  @map("overridden_by_id")
  overrideNotes         String?  @map("override_notes")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([actionType, riskLevel])
  @@index([riskScore, createdAt])
  @@index([ipAddress])
  @@index([deviceFingerprintHash])
  @@map("risk_assessment_records")
}

model DeviceFingerprintRecord {
  id                String   @id @default(uuid())
  fingerprintHash   String   @unique @map("fingerprint_hash")
  userId            String?  @map("user_id")
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rawTelemetryJson  String?  @map("raw_telemetry_json")
  canvasHash        String?  @map("canvas_hash")
  webglHash         String?  @map("webgl_hash")
  userAgent         String?  @map("user_agent")
  language          String?
  screenResolution  String?  @map("screen_resolution")
  timezone          String?
  isBlocked         Boolean  @default(false) @map("is_blocked")
  blockReason       String?  @map("block_reason")
  trustScore        Int      @default(100) @map("trust_score")
  linkedUserIdsJson String   @default("[]") @map("linked_user_ids_json")
  firstSeenAt       DateTime @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime @default(now()) @map("last_seen_at")

  @@index([fingerprintHash])
  @@index([userId])
  @@index([isBlocked])
  @@map("device_fingerprint_records")
}

model PaymentInstrumentFingerprint {
  id                String   @id @default(uuid())
  cardHash          String   @unique @map("card_hash") // SHA256 of tokenized card fingerprint
  binNumber         String?  @map("bin_number")
  lastFour          String?  @map("last_four")
  cardBrand         String?  @map("card_brand")
  cardCountry       String?  @map("card_country")
  isPrepaid         Boolean  @default(false) @map("is_prepaid")
  linkedUserIdsJson String   @default("[]") @map("linked_user_ids_json")
  totalTransactions Int      @default(0) @map("total_transactions")
  totalDisputes     Int      @default(0) @map("total_disputes")
  totalChargebacks  Int      @default(0) @map("total_chargebacks")
  isBlocked         Boolean  @default(false) @map("is_blocked")
  blockReason       String?  @map("block_reason")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([cardHash])
  @@index([binNumber])
  @@index([isBlocked])
  @@map("payment_instrument_fingerprints")
}

model WalletHold {
  id               String    @id @default(uuid())
  walletId         String    @map("wallet_id")
  wallet           Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCredits    Int       @map("amount_credits")
  reason           String
  status           String    @default("HELD") @map("status") // HELD, RELEASED, SEIZED_CHARGEBACK, REFUNDED
  riskAssessmentId String?   @map("risk_assessment_id")
  releaseAt        DateTime  @map("release_at")
  releasedAt       DateTime? @map("released_at")
  releaseNotes     String?   @map("release_notes")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([walletId, status])
  @@index([userId, status])
  @@index([releaseAt, status])
  @@map("wallet_holds")
}

// ============================================================================
// 18. CREATOR AFFILIATE, REFERRAL ATTRIBUTION & COMMISSION LEDGER
// ============================================================================

model CreatorReferralCode {
  id                    String         @id @default(uuid())
  creatorProfileId      String         @map("creator_profile_id")
  creatorProfile        CreatorProfile @relation("CreatorReferralCodes", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  code                  String         @unique // Vanity code e.g. "LOLA_VIP", "SUMMER26"
  campaignName          String?        @map("campaign_name") // e.g. "Twitter Promo", "Instagram Bio"
  commissionRatePercent Float          @default(10.0) @map("commission_rate_percent") // e.g. 10.0%
  cookieWindowDays      Int            @default(30) @map("cookie_window_days")
  spendWindowDays       Int            @default(30) @map("spend_window_days")
  isActive              Boolean        @default(true) @map("is_active")
  totalClicks           Int            @default(0) @map("total_clicks")
  totalSignups          Int            @default(0) @map("total_signups")
  totalEarningsCredits  BigInt         @default(0) @map("total_earnings_credits")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  touchpoints  ReferralTouchpoint[]  @relation("ReferralCodeTouchpoints")
  attributions ReferralAttribution[] @relation("ReferralCodeAttributions")

  @@index([creatorProfileId, isActive])
  @@index([code])
  @@map("creator_referral_codes")
}

model ReferralTouchpoint {
  id                    String               @id @default(uuid())
  referralCodeId        String?              @map("referral_code_id")
  referralCode          CreatorReferralCode? @relation("ReferralCodeTouchpoints", fields: [referralCodeId], references: [id], onDelete: SetNull)
  creatorProfileId      String               @map("creator_profile_id")
  creatorProfile        CreatorProfile       @relation("CreatorTouchpoints", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  userId                String?              @map("user_id")
  user                  User?                @relation("TouchpointUser", fields: [userId], references: [id], onDelete: SetNull)
  anonymousSessionId    String               @map("anonymous_session_id")
  deviceFingerprintHash String?              @map("device_fingerprint_hash")
  ipAddress             String?              @map("ip_address")
  userAgent             String?              @map("user_agent")
  landingPage           String?              @map("landing_page")
  utmSource             String?              @map("utm_source")
  utmMedium             String?              @map("utm_medium")
  utmCampaign           String?              @map("utm_campaign")
  createdAt             DateTime             @default(now()) @map("created_at")

  @@index([referralCodeId, createdAt])
  @@index([creatorProfileId, createdAt])
  @@index([anonymousSessionId])
  @@index([deviceFingerprintHash])
  @@index([ipAddress])
  @@map("referral_touchpoints")
}

model ReferralAttribution {
  id                           String               @id @default(uuid())
  referredUserId               String               @unique @map("referred_user_id")
  referredUser                 User                 @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  referralCodeId               String?              @map("referral_code_id")
  referralCode                 CreatorReferralCode? @relation("ReferralCodeAttributions", fields: [referralCodeId], references: [id], onDelete: SetNull)
  referringCreatorProfileId    String               @map("referring_creator_profile_id")
  referringCreatorProfile      CreatorProfile       @relation("ReferringCreator", fields: [referringCreatorProfileId], references: [id], onDelete: Cascade)
  attributionModel             AttributionModelType @default(LAST_TOUCH) @map("attribution_model")
  status                       AttributionStatus    @default(ACTIVE) @map("status")
  commissionRatePercent        Float                @default(10.0) @map("commission_rate_percent")
  spendWindowDays              Int                  @default(30) @map("spend_window_days")
  windowExpiresAt              DateTime             @map("window_expires_at")
  totalCommissionEarnedCredits Int                  @default(0) @map("total_commission_earned_credits")
  totalReferredSpendCredits    Int                  @default(0) @map("total_referred_spend_credits")
  fraudCheckStatus             String               @default("PASSED") @map("fraud_check_status") // PASSED, FLAGGED_REVIEW, BLOCKED
  fraudReason                  String?              @map("fraud_reason")
  attributedAt                 DateTime             @default(now()) @map("attributed_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")

  commissions AffiliateCommissionLedger[]

  @@index([referringCreatorProfileId, status])
  @@index([referredUserId])
  @@index([windowExpiresAt, status])
  @@map("referral_attributions")
}

model AffiliateCommissionLedger {
  id                        String                    @id @default(uuid())
  referralAttributionId     String                    @map("referral_attribution_id")
  referralAttribution       ReferralAttribution       @relation(fields: [referralAttributionId], references: [id], onDelete: Cascade)
  referringCreatorProfileId String                    @map("referring_creator_profile_id")
  referringCreatorProfile   CreatorProfile            @relation("ReferringCreatorCommissions", fields: [referringCreatorProfileId], references: [id], onDelete: Cascade)
  referredUserId            String                    @map("referred_user_id")
  referredUser              User                      @relation("ReferredFanCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  sourceType                AffiliateSourceType       @map("source_type")
  sourceTransactionId       String?                   @map("source_transaction_id")
  grossAmountCredits        Int                       @map("gross_amount_credits")
  commissionRatePercent     Float                     @map("commission_rate_percent")
  commissionCredits         Int                       @map("commission_credits")
  status                    AffiliateCommissionStatus @default(CLEARED) @map("status")
  creatorEarningId          String?                   @map("creator_earning_id")
  notes                     String?
  createdAt                 DateTime                  @default(now()) @map("created_at")

  @@index([referringCreatorProfileId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([referralAttributionId])
  @@index([status])
  @@map("affiliate_commission_ledgers")
}

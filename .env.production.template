# ============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE (.env.production.template)
# Purpose: Authoritative Production Deployment Specification
# CRITICAL: Secrets must be injected via AWS Secrets Manager / Vault / CI/CD secrets.
# NEVER commit populated production credentials into version control.
# ============================================================================

NODE_ENV="production"
APP_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_NAME="AuraLive"
NEXT_PUBLIC_APP_URL="https://auralive.com"

# Production PostgreSQL (Managed Multi-AZ RDS Cluster with Read Replicas & SSL)
DATABASE_URL="postgresql://db_prod_app:${PROD_DB_PASSWORD}@prod-db-cluster.us-east-1.rds.amazonaws.com:5432/adult_platform_prod?schema=public&sslmode=require"
DATABASE_MAX_CONNECTIONS=50
DATABASE_IDLE_TIMEOUT_MS=30000

# Production Redis (AWS ElastiCache Redis Cluster with Multi-AZ Replication)
REDIS_URL="rediss://default:${PROD_REDIS_PASSWORD}@prod-redis.cluster.us-east-1.cache.amazonaws.com:6379"
REDIS_KEY_PREFIX="platform:prod:"

# Production Payment Gateway (Live CCBill / SegPay Merchant API)
# STRICT RULE: Mock adapters strictly forbidden in production.
PAYMENT_GATEWAY_PROVIDER="ccbill"
PAYMENT_WEBHOOK_SECRET="${PROD_CCBILL_WEBHOOK_SECRET_MIN_32_CHARS}"
PLATFORM_FEE_PERCENTAGE=20
ALLOW_MOCK_PAYMENTS="false"
PAYMENT_MERCHANT_ACCOUNT_ID="${PROD_CCBILL_MERCHANT_ID}"
PAYMENT_SUB_ACCOUNT_ID="${PROD_CCBILL_SUB_ACCOUNT}"

# Production 18+ & 2257 Compliance
AGE_GATE_ENFORCEMENT="true"
KYC_PROVIDER="persona"
KYC_API_KEY="${PROD_PERSONA_LIVE_API_KEY}"
COMPLIANCE_2257_STORAGE_BUCKET="auralive-prod-2257-vault-compliance"
COMPLIANCE_STORAGE_ENCRYPTION_KEY="${PROD_2257_KMS_AES256_KEY}"

# Production Video Streaming & Global CDN
LIVESTREAM_PROVIDER="livekit"
LIVESTREAM_API_KEY="${PROD_LIVEKIT_API_KEY}"
LIVESTREAM_API_SECRET="${PROD_LIVEKIT_API_SECRET}"
MEDIA_CDN_BASE_URL="https://cdn.auralive.com"
PROTECTED_MEDIA_STORAGE_BUCKET="auralive-prod-ppv-protected-media"

# Production Security & Audit Controls
# STRICT RULE: Debug endpoints and data mutation scripts are forbidden in production.
SESSION_SECRET="${PROD_SESSION_HMAC_SECRET_MIN_32_CHARS}"
ENABLE_DEBUG_ENDPOINTS="false"
ALLOW_DATA_MUTATION_SCRIPTS="false"
ENABLE_AUDIT_LOG_STREAMING="true"

# ============================================================================
# MASTER ENVIRONMENT TEMPLATE (.env.example)
# Platform: 18+ Live Creator Streaming, Economy & Trust Architecture
# ============================================================================

# ----------------------------------------------------------------------------
# 1. RUNTIME & ENVIRONMENT IDENTITY
# ----------------------------------------------------------------------------
# Target runtime tier: development | staging | production | test
NODE_ENV="development"
APP_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_NAME="AuraLive"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 2. AUTHORITATIVE DATASTORE & CACHE
# ----------------------------------------------------------------------------
# PostgreSQL Authoritative Database Connection
# In Production: Must be external managed cluster (AWS RDS / Aurora / CloudSQL) with SSL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adult_platform?schema=public"
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=30000

# Redis Cache, Sorted Sets & Pub/Sub Event Bus
# In Production: Must be managed Redis cluster (AWS ElastiCache / Upstash)
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="platform:development:"

# ----------------------------------------------------------------------------
# 3. ECONOMIC ENGINE & PAYMENT GATEWAYS
# ----------------------------------------------------------------------------
# Gateway Provider: ccbill | segpay | epoch | stripe | ccbill_mock (DEV ONLY)
PAYMENT_GATEWAY_PROVIDER="ccbill_mock"
PAYMENT_WEBHOOK_SECRET="whsec_development_placeholder_key_32char_min"
PLATFORM_FEE_PERCENTAGE=20
ALLOW_MOCK_PAYMENTS="true"

# CCBill / SegPay Merchant Configuration
PAYMENT_MERCHANT_ACCOUNT_ID="951234"
PAYMENT_SUB_ACCOUNT_ID="0001"
PAYMENT_FORM_NAME="ccbill_stream_pass"

# ----------------------------------------------------------------------------
# 4. TRUST, SAFETY & 2257 COMPLIANCE
# ----------------------------------------------------------------------------
# 18+ Age Gate Enforcement (Strictly enforced in Staging & Production)
AGE_GATE_ENFORCEMENT="true"

# Identity Verification (KYC) Provider: persona | veriff | persona_mock (DEV ONLY)
KYC_PROVIDER="persona_mock"
KYC_API_KEY="test_kyc_api_key"
KYC_TEMPLATE_ID="tmpl_adult_creator_2257"

# 2257 Custodian Records Encrypted Vault Storage Bucket
COMPLIANCE_2257_STORAGE_BUCKET="vault-2257-compliance-local"
COMPLIANCE_STORAGE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ----------------------------------------------------------------------------
# 5. VIDEO STREAMING & MEDIA STORAGE CDN
# ----------------------------------------------------------------------------
# Livestream Provider: livekit | mux | cloudflare_stream | livepeer_mux_mock (DEV ONLY)
LIVESTREAM_PROVIDER="livepeer_mux_mock"
LIVESTREAM_API_KEY="dev_live_api_key"
LIVESTREAM_API_SECRET="dev_live_api_secret"

# Public Media CDN & Protected Storage
MEDIA_CDN_BASE_URL="https://cdn.platform.local"
PROTECTED_MEDIA_STORAGE_BUCKET="protected-ppv-media-local"

# S3 Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ----------------------------------------------------------------------------
# 6. SECURITY & RUNTIME GUARDS
# ----------------------------------------------------------------------------
SESSION_SECRET="dev_insecure_session_secret_for_local_only_12345678"
ENABLE_DEBUG_ENDPOINTS="true"
ALLOW_DATA_MUTATION_SCRIPTS="true"
ENABLE_AUDIT_LOG_STREAMING="false"

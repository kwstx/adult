# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.development)
# Purpose: Local engineering workflow against local services & mock providers
# ============================================================================

NODE_ENV="development"
APP_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_NAME="AuraLive (Dev)"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adult_platform?schema=public"
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=10000

# Local Redis
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="platform:dev:"

# Mock Payment Gateway (Zero real credit card / financial charges)
PAYMENT_GATEWAY_PROVIDER="ccbill_mock"
PAYMENT_WEBHOOK_SECRET="whsec_dev_local_testing_secret_key_12345678"
PLATFORM_FEE_PERCENTAGE=20
ALLOW_MOCK_PAYMENTS="true"

# Trust & Safety
AGE_GATE_ENFORCEMENT="true"
KYC_PROVIDER="persona_mock"
COMPLIANCE_2257_STORAGE_BUCKET="vault-2257-compliance-dev"

# Video Streaming & CDN (Local Mock SFU / Ingest)
LIVESTREAM_PROVIDER="livepeer_mux_mock"
MEDIA_CDN_BASE_URL="http://localhost:3000/media-mock"
PROTECTED_MEDIA_STORAGE_BUCKET="protected-ppv-media-dev"

# Security & Operational Controls
SESSION_SECRET="dev_session_secret_local_only_abcdef12345678"
ENABLE_DEBUG_ENDPOINTS="true"
ALLOW_DATA_MUTATION_SCRIPTS="true"
ENABLE_AUDIT_LOG_STREAMING="false"
